# Production Environment Configuration
# Copy to the relevant .env file and fill in your values
# NEVER commit real credentials to this file

# ── Frontend (.env.local) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Smart Contract Addresses (0G Galileo Testnet)
NEXT_PUBLIC_CONTRACT_ADDRESS=<SmartChainTransaction address>
NEXT_PUBLIC_PAYMENTS_CONTRACT=<SmartChainPayments address>
NEXT_PUBLIC_AGENT_ID_CONTRACT=<SmartChainAgentID address>
NEXT_PUBLIC_REVENUE_CONTRACT=<SmartChainRevenue address>
NEXT_PUBLIC_AGENT_ESCROW_CONTRACT=<SmartChainAgentEscrow address>

# 0G Storage
NEXT_PUBLIC_STORAGE_PRIVATE_KEY=<your-wallet-private-key>
STORAGE_PRIVATE_KEY=<your-wallet-private-key>

# AI Agent
NEXT_PUBLIC_AI_AGENT_URL=https://<your-ai-agent>.onrender.com
NEXT_PUBLIC_BACKEND_URL=https://<your-backend>.onrender.com
NEXT_PUBLIC_CHAIN=og_newton
NEXT_PUBLIC_APP_URL=https://<your-frontend>.vercel.app

# Payment Processing (optional)
STRIPE_SECRET_KEY=sk_test_<your-stripe-key>
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-<your-flutterwave-key>

# ── AI Agent (.env in ai-agent/) ─────────────────────────────────
OG_COMPUTE_PRIVATE_KEY=<your-wallet-private-key>
OG_COMPUTE_RPC=https://evmrpc-testnet.0g.ai
OG_COMPUTE_BROKER_URL=https://broker.0g.ai
OG_COMPUTE_MODEL=llama-3.1-8b-instruct
STORAGE_PRIVATE_KEY=<your-wallet-private-key>
FLASK_ENV=production
PORT=5000

# ── Backend (.env in smartchain_hub_backend/) ────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://<your-frontend>.vercel.app
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=<your-supabase-service-role-key>
AI_AGENT_URL=https://<your-ai-agent>.onrender.com
BLOCKCHAIN_PRIVATE_KEY=<your-wallet-private-key>

# ── Blockchain (.env in blockchain/) ─────────────────────────────
PRIVATE_KEY=<your-deployer-wallet-private-key>
