# ── 0G Compute (broker pattern — docs.0g.ai/build-with-0g/compute-network) ───
# Your funded wallet private key (must have 0G tokens deposited via broker)
OG_COMPUTE_PRIVATE_KEY=<your_wallet_private_key>

# 0G testnet RPC (use https://evmrpc.0g.ai for mainnet)
OG_COMPUTE_RPC=https://evmrpc-testnet.0g.ai

OG_COMPUTE_BROKER_URL=https://broker.0g.ai
OG_COMPUTE_MODEL=llama-3.1-8b-instruct

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_ENV=production
PORT=5000
